# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role: solo servidor, saltea RLS. La usa únicamente el emisor
# de notificaciones (lib/push/send.ts) para leer las suscripciones de OTROS
# usuarios. Sin ella no se puede notificar a nadie más que a vos mismo.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID). Genera un par nuevo con:
#   npx web-push generate-vapid-keys
#
# La clave pública se inlinea en el bundle del cliente en tiempo de BUILD:
# cambiarla en el panel del hosting no basta, hay que redeployar.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Clave privada: solo servidor. Nunca la prefijes con NEXT_PUBLIC_.
VAPID_PRIVATE_KEY=

# Contacto que exige el estándar Web Push para identificar al emisor.
VAPID_SUBJECT=mailto:hola@kancha.app
